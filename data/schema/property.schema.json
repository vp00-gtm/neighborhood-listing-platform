{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/property.schema.json",
  "title": "Neighborhood Property Listing",
  "description": "Data contract for a fictional neighborhood property listing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "property_id",
    "address",
    "price",
    "bedrooms",
    "bathrooms",
    "square_feet",
    "amenities",
    "local_sponsors"
  ],
  "properties": {
    "property_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique identifier for the property."
    },
    "address": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "street",
        "city",
        "state",
        "zip_code"
      ],
      "properties": {
        "street": {
          "type": "string",
          "minLength": 1
        },
        "city": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "pattern": "^[A-Z]{2}$",
          "description": "Two-letter U.S. state abbreviation."
        },
        "zip_code": {
          "type": "string",
          "pattern": "^[0-9]{5}$",
          "description": "Five-digit U.S. ZIP code."
        }
      }
    },
    "price": {
      "type": "number",
      "minimum": 0,
      "description": "Monthly rental price in U.S. dollars."
    },
    "bedrooms": {
      "type": "integer",
      "minimum": 0
    },
    "bathrooms": {
      "type": "number",
      "minimum": 0
    },
    "square_feet": {
      "type": "integer",
      "minimum": 0
    },
    "amenities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "local_sponsors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sponsor_id",
          "name",
          "sponsor_url"
        ],
        "properties": {
          "sponsor_id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "sponsor_url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    }
  }
}